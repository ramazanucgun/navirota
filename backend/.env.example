NODE_ENV=development
PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=smartway
PGPASSWORD=smartway
PGDATABASE=smartway_avm
DATABASE_URL=postgresql://smartway:smartway@localhost:5432/smartway_avm

JWT_SECRET=change-me-in-production

# Yönetim panellerinin (admin/store/superadmin/auth) çağrılmasına izin
# verilen origin'ler, virgülle ayrılmış (örn. https://app.smartwayavm.com).
# Boş bırakılırsa (yalnızca geliştirme için önerilir) kısıtlama uygulanmaz.
ALLOWED_ORIGINS=

# Parola sıfırlama e-postalarındaki bağlantının başına eklenecek adres.
# Boş bırakılırsa istek başlıklarından (Host) otomatik türetilir.
FRONTEND_URL=

# SMTP (parola sıfırlama e-postaları için). SMTP_HOST boşsa e-postalar
# gerçekten gönderilmez, yalnızca sunucu konsoluna loglanır (dev-mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartWay AVM <no-reply@smartwayavm.com>

# iyzico (ödeme/abonelik). Anahtarlar tanımlı değilse (ya da IYZICO_MOCK=true
# ise) sistem MOCK modda çalışır: gerçek ağ çağrısı yapılmaz, checkout/callback
# akışı simüle "başarılı ödeme" ile test edilebilir — GERÇEK PARA ALINMAZ.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MOCK=true

# Sentry (hata izleme). Tanımlı değilse hiçbir şey Sentry'ye gönderilmez,
# yalnızca sunucu console log'larında görünür.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Redis (yatay ölçekte paylaşılan rate-limit sayacı için). Tanımlı değilse
# rate-limit in-memory (tek instance) modda çalışmaya devam eder.
REDIS_URL=

# Doğal dil arama — LLM katmanı (services/aiSearch.js). Sözlük hiçbir
# kategoriyle eşleşmezse ve ANTHROPIC_API_KEY tanımlıysa Claude Haiku'ya
# tek bir sınıflandırma isteği atılır. Tanımlı değilse yalnızca sözlük
# tabanlı arama çalışır (davranış değişmez).
ANTHROPIC_API_KEY=
AI_SEARCH_MODEL=claude-haiku-4-5-20251001
AI_SEARCH_MOCK=false
